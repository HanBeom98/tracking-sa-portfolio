      },
      {
        "source": "/page-14.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/page-14/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en/**",
        "destination": "/",
