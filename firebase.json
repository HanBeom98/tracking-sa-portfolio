{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "cloud-functions",
    "runtime": "nodejs22",
    "predeploy": ["node scripts/sync-replay-coaching-modules.mjs --check"]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/guides/map-analysis-guide",
        "destination": "/guides/map-sample-report/",
        "type": 301
      },
      {
        "source": "/guides/map-analysis-guide/**",
        "destination": "/guides/map-sample-report/",
        "type": 301
      },
      {
        "source": "/guides/map-analysis-practice",
        "destination": "/guides/map-sample-report/",
        "type": 301
      },
      {
        "source": "/guides/map-analysis-practice/**",
        "destination": "/guides/map-sample-report/",
        "type": 301
      },
      {
        "source": "/guides/map-distribution-report",
