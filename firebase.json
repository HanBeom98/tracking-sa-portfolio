        "type": 301
      },
      {
        "source": "/animal-face",
        "destination": "/stats/sudden-attack/",
        "type": 301
      },
      {
        "source": "/animal-face/**",
        "destination": "/stats/sudden-attack/",
        "type": 301
      },
      {
        "source": "/fortune",
        "destination": "/stats/sudden-attack/",
        "type": 301
      },
      {
        "source": "/fortune/**",
        "destination": "/stats/sudden-attack/",
