{
  "name": "tracking-sa",
  "version": "1.0.0",
  "description": "Sudden Attack player stats search and community website",
  "type": "module",
  "scripts": {
    "build": "node scripts/run-build.js --build-only",
    "build:full": "node scripts/run-build.js",
    "sync:public": "bash scripts/sync_public_assets.sh",
    "check:public-sync": "bash scripts/sync_public_assets.sh --check",
    "check:public-edit-policy": "node scripts/check-public-edit-policy.js",
    "check:source-of-truth": "node scripts/check-source-of-truth.js",
    "check:build-artifacts": "node scripts/check-build-artifacts.js",
    "check:ddd-boundary": "node scripts/check-ddd-boundary.js",
    "check:application-browser-boundary": "node scripts/check-application-browser-boundary.js",
    "check:source-graph": "node scripts/check-source-graph.js",
    "test:smoke:release": "bash scripts/smoke_auth_release.sh",
    "test:rules": "node --test --experimental-test-isolation=none tests/unit/firestore-rules-guards.test.js",
    "test:emulator": "node tests/emulator/run-tests.mjs",
    "test:e2e:ci": "playwright test --config tests/e2e/playwright.ci.config.js",
    "test:e2e:auth:local": "node tests/emulator/run-tests.mjs --browser",
    "test:e2e:coaching:local": "node tests/emulator/run-tests.mjs --coaching",
    "test:unit": "node --test --experimental-test-isolation=none tests/unit/*.test.js",
    "test:unit:account": "node --test --experimental-test-isolation=none tests/unit/account-*.test.js",
    "test:unit:auth": "node --test --experimental-test-isolation=none tests/unit/auth-*.test.js tests/unit/app-shell-runtime.test.js",
    "test:unit:board": "node --test --experimental-test-isolation=none tests/unit/board-*.test.js",
    "test:unit:search": "node --test --experimental-test-isolation=none tests/unit/search-*.test.js",
    "test:e2e": "npm run test:e2e:ci",
    "test:e2e:auth": "npm run test:e2e:auth:local",
    "test": "npm run test:unit",
    "test:e2e:smoke": "npm run test:e2e:ci",
    "test:python": "node scripts/run-build.js --python-tests",
    "test:e2e:production": "playwright test --config tests/e2e/playwright.production.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "acorn": "8.15.0"
  }
}
